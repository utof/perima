#!/usr/bin/env bash
set -euo pipefail

# Pre-commit hook: run the full CI recipe.
#
# Env setup (PATH + PKG_CONFIG_PATH + LIBRARY_PATH) now lives in the
# justfile (`export ... :=` top-of-file). RUSTFLAGS lives in
# `.cargo/config.toml` ([build] rustflags). No per-hook exports needed.
#
# Thin-pre-commit + thick-pre-push split is tracked as issue #52 /
# Task #63. When that lands, this hook should drop `just ci` in favour
# of `just ci-fast` (fmt + clippy + lint only; tests move to pre-push).

just ci
