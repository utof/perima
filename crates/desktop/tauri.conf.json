{
  "productName": "perima",
  "identifier": "dev.perima.desktop",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../apps/desktop/dist"
  },
  "app": {
    "windows": [
      {
        "title": "perima",
        "width": 1024,
        "height": 768
      }
    ],
    "security": {
      "capabilities": ["default"],
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/perima/thumbnails/**",
          "$APPLOCALDATA/perima/thumbnails/**"
        ]
      }
    }
  },
  "bundle": {
    "externalBin": ["binaries/ffmpeg"]
  },
  "plugins": {}
}
